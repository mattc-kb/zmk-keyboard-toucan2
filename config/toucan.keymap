#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>

#define BASE 0
#define SYM  1
#define NAV  2
#define ADJ  3
#define MOU  4

/ {
    conditional_layers {
        compatible = "zmk,conditional-layers";
        tri_layer {
            if-layers = <1 2>;
            then-layer = <3>;
        };
    };

    behaviors {
        bspc_del: backspace_delete {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp BACKSPACE>, <&kp DEL>;

            mods = <(MOD_LSFT|MOD_RSFT)>;
            label = "backspace_delete";
        };

        td_alt: tap_dance_alt {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <200>;
            bindings = <&kp LALT>, <&kp LC(LALT)>;
        };
    };

    combos {
        compatible = "zmk,combos";

        lshift_combo {
            bindings = <&kp LEFT_SHIFT>;
            key-positions = <14 15>;
        };

        rshift_combo {
            bindings = <&kp RIGHT_SHIFT>;
            key-positions = <21 20>;
        };

        Enter_combo {
            bindings = <&kp ENTER>;
            key-positions = <22 21 20>;
        };

        backspace_combo {
            timeout-ms = <5>;
            bindings = <&bspc_del>;
            key-positions = <9 10>;
        };

        lctrl_combo {
            bindings = <&kp LCTRL>;
            key-positions = <13 14>;
        };

        rctrl_combo {
            bindings = <&kp LCTRL>;
            key-positions = <21 22>;
        };

        tab_combo {
            bindings = <&kp TAB>;
            key-positions = <2 3>;
        };

        esc_combo {
            bindings = <&kp ESC>;
            key-positions = <1 2>;
        };

        Apostrophe {
            bindings = <&kp SQT>;
            key-positions = <7 8>;
        };

        Del-combo {
            bindings = <&bspc_del>;
            key-positions = <8 9>;
        };

        Delete {
            bindings = <&kp DEL>;
            key-positions = <8 9 10>;
        };

        ctrl_win {
            bindings = <&kp LC(LGUI)>;
            key-positions = <25 26>;
        };

        left_desktop {
            bindings = <&kp LC(LG(LEFT_ARROW))>;
            key-positions = <25 26 27>;
        };

        right_desktop {
            bindings = <&kp LC(LG(RIGHT_ARROW))>;
            key-positions = <32 33 34>;
        };

        LeftDel {
            bindings = <&kp DELETE>;
            key-positions = <1 2 3>;
        };

        clearBTprofile {
            bindings = <&bt BT_CLR>;
            key-positions = <29 28 27>;
        };

        low_apostrophe_r {
            bindings = <&kp SQT>;
            key-positions = <33 32>;
        };

        ctrl_shft_l {
            bindings = <&kp LS(LCTRL)>;
            key-positions = <13 14 15>;
        };

        ctrl_shft_r {
            bindings = <&kp RS(RCTRL)>;
            key-positions = <22 21 20>;
        };

        iPad_windows {
            bindings = <&kp GLOBE(UP_ARROW)>;
            key-positions = <16 15 14>;
        };

        bootloader {
            bindings = <&bootloader>;
            key-positions = <1 2 3 4>;
        };

        backtick {
            bindings = <&kp GRAVE>;
            key-positions = <3 4>;
        };

        alt_combo {
            bindings = <&kp LALT>;
            key-positions = <4 5>;
        };

    };
    
    keymap {
        compatible = "zmk,keymap";

        base {
            display-name = "BASE";
            bindings = <
&kp TAB              &kp Q  &kp W  &kp E     &kp R  &kp T      &kp Y      &kp U  &kp I         &kp O    &kp P     &bspc_del
&kp LCTRL            &kp A  &kp S  &kp D     &kp F  &kp G      &kp H      &kp J  &kp K         &kp L    &kp SEMI  &kp SQT
&mt LEFT_SHIFT CAPS  &kp Z  &kp X  &kp C     &kp V  &kp B      &kp N      &kp M  &kp COMMA     &kp DOT  &kp FSLH  &kp RIGHT_SHIFT
                                   &kp LGUI  &mo 1  &kp RET    &kp SPACE  &mo 2  &td_alt
            >;
        };

        sym {
            display-name = "SYM";
            bindings = <
&kp ESC    &kp EXCL      &kp AT        &kp HASH      &kp DLLR      &kp PRCNT             &kp CARET  &kp AMPS      &kp ASTRK  &kp LPAR  &kp RPAR  &kp DEL
&kp LCTRL  &trans        &trans        &trans        &trans        &kp LS(APOSTROPHE)    &kp PIPE   &kp LS(NUBS)  &kp BSLH   &kp LBKT  &kp RBKT  &kp GRAVE
&kp LSHFT  &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4          &kp PLUS   &kp MINUS     &kp EQUAL  &kp LBRC  &kp RBRC  &kp NUBS
                                       &trans        &trans        &trans                &trans     &trans        &trans
            >;
        };

        nav {
            display-name = "NAV";
            bindings = <
&kp ESC    &kp N1          &kp N2    &kp N3  &kp N4   &kp N5          &kp N6       &kp N7     &kp N8     &kp N9        &kp N0                &kp BSPC
&kp LCTRL  &kp HOME   &kp PAGE_UP  &kp PAGE_DOWN   &kp END  &kp LS(APOS)    &kp PAGE_UP  &kp LEFT   &kp DOWN   &kp UP_ARROW  &kp RIGHT             &trans
&kp LSHFT  &kp CARET       &none     &none   &tog ADJ   &kp F11         &kp PLUS     &kp MINUS  &kp EQUAL  &trans        &kp NON_US_BACKSLASH  &none
                                     &trans  &trans   &trans          &trans       &trans     &trans
            >;
        };

        adj {
            display-name = "ADJ";
            bindings = <
&none   &kp F1   &kp F2   &kp F3  &kp F4  &kp F5     &kp FSLH   &kp N7  &kp N8      &kp N9  &kp MINUS  &trans
&none   &kp F6   &kp F7   &kp F8  &kp F9  &kp F10    &kp ASTRK  &kp N4  &kp N5      &kp N6  &kp PLUS   &trans
&trans  &kp F11  &kp F12  &trans  &trans  &trans     &trans     &kp N1  &kp N2      &kp N3  &kp EQUAL  &trans
                          &trans  &tog 3  &trans     &trans     &kp N0  &kp PERIOD
            >;
        };

        mouse {
            display-name = "MOU";
            bindings = <
                &trans &trans &trans &trans &trans &trans           &trans &trans &trans &trans &trans &trans
                &trans &trans &trans &trans &trans &trans           &trans &trans &trans &trans &trans &trans
                &trans &trans &trans &trans &trans &trans           &trans &trans &trans &trans &trans &trans
                            &mkp MCLK &mkp RCLK &mkp LCLK           &mkp LCLK &mkp RCLK &mkp MCLK
            >;
        };

        extra_2 {
                status = "reserved";
        };

        extra_3 {
                status = "reserved";
        };
    };
};
